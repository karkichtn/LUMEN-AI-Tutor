# LUMEN Environment Configuration Template
# Duplicate this file to .env and configure your variables

# Google Gemini API Key (Required for AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Server
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-in-production-to-a-strong-secret-key-32chars

# SQLite Persistent Database
DATABASE_URL=sqlite+aiosqlite:///lumen.db

# Initial Administrator Credentials
# On startup, Lumen provisions an administrator account with these credentials if it doesn't already exist.
ADMIN_EMAIL=admin@lumen.ai
ADMIN_PASSWORD=Admin@Lumen2026!

# Plan Limits
FREE_RATE_LIMIT_MSGS=35
FREE_RATE_LIMIT_WINDOW_HOURS=3
FREE_CONTEXT_TURNS=8
PLUS_CONTEXT_TURNS=20
